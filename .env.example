# Copy to .env and adjust. All settings are optional; defaults shown.
# Prefix is IE_ ; consumed by insurance_extractor.config.Settings.

# --- OCR ---
IE_OCR_LANG=eng
IE_PDF_DPI=200
# IE_TESSERACT_CMD=/opt/homebrew/bin/tesseract   # only if not on PATH

# --- Mapping strategy: rule | llm | auto ---
IE_DEFAULT_STRATEGY=rule
IE_OLLAMA_URL=http://localhost:11434/api/chat
IE_OLLAMA_MODEL=qwen2.5:3b
IE_OLLAMA_TIMEOUT_S=120

# --- Input guards ---
IE_MAX_UPLOAD_MB=15
IE_MAX_PAGES=10

# --- App / logging ---
IE_LOG_LEVEL=INFO
IE_JSON_LOGS=true
