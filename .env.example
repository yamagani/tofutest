# Copy to .env and adjust. All settings are optional; defaults shown.
# Prefix is IE_ ; consumed by insurance_extractor.config.Settings.

# --- OCR ---
IE_OCR_LANG=eng
IE_PDF_DPI=200
# IE_TESSERACT_CMD=/opt/homebrew/bin/tesseract   # only if not on PATH

# --- Mapping strategy: rule | llm | auto ---
IE_DEFAULT_STRATEGY=rule
IE_OLLAMA_URL=http://localhost:11434/api/chat
IE_OLLAMA_MODEL=qwen2.5:3b
IE_OLLAMA_TIMEOUT_S=120

# --- Input guards ---
IE_MAX_UPLOAD_MB=15
IE_MAX_PAGES=10

# --- Async jobs / storage ---
# memory = in-process (no AWS); dynamo = DynamoDB + S3 (LocalStack or real AWS)
IE_STORE_BACKEND=memory
IE_WORKER_CONCURRENCY=2
# IE_WORKER_INLINE=false        # true = process synchronously (tests only)

# --- AWS / LocalStack (used when IE_STORE_BACKEND=dynamo) ---
IE_AWS_REGION=us-east-1
# IE_AWS_ENDPOINT_URL=http://localhost:4566   # set to LocalStack; unset for real AWS
IE_DDB_TABLE=insurance_jobs
IE_S3_BUCKET=insurance-documents
IE_AUTO_CREATE_RESOURCES=true   # create table/bucket on startup (set false in prod IaC)

# boto3 credentials (LocalStack accepts anything; real AWS uses the role chain)
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# --- App / logging ---
IE_LOG_LEVEL=INFO
IE_JSON_LOGS=true
